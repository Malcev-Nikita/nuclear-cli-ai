# Личные настройки. Скопируй этот файл как config.local.toml и оставь только
# то, что хочешь поменять — остальное возьмётся из config.toml.
# config.local.toml в .gitignore: git pull его не тронет.

[assistant]
names = ["мага"]
# Характер ассистента в болтовне и пересказах (можно многострочно в """...""").
lore = "Тебя зовут Мага, ты дерзкий, но добрый, отвечаешь коротко и с юмором."

[internet]
weather_city = "Астрахань"

[b24]
# Входящий вебхук Битрикс24: Разработчикам → Другое → Входящий вебхук
# (права: задачи, профиль). Секрет — поэтому здесь, а не в config.toml.
b24_webhook = ""

[tts]
voice = "ru_RU-irina-medium"
speed = 1.5
